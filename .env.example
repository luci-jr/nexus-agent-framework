# Nexus Ecosystem (Open Source Edition) — Variáveis de Ambiente
#
# Copie para .env e preencha. Nenhuma destas variáveis tem valor padrão
# secreto no código: o que não for definido fica desativado.

# Porta do console (CONSOLE_PORT tem prioridade sobre PORT)
CONSOLE_PORT=8090
NEXUS_ENV=production

# Nome mostrado para o usuário autenticado
CONSOLE_USER=admin

# Senha mestra do console (mínimo de 12 caracteres).
# Se ficar vazia, o console gera uma senha aleatória na primeira execução,
# grava em .console_pass e mostra uma única vez no log.
# Gere uma com: openssl rand -hex 16
CONSOLE_PASSWORD=

# true = exige login também para LER tarefas, ADRs, grafo, anexos e conteúdo.
# Recomendado em qualquer instalação exposta à internet.
CONSOLE_PRIVATE=true

# Use SOMENTE em localhost: desliga toda a autenticação.
# CONSOLE_NO_AUTH=true

# Ponte do WhatsApp (desligada enquanto BRIDGE_AUTH_TOKEN estiver vazio)
# BRIDGE_AUTH_TOKEN=
# NEXUS_OWNER_WHATSAPP=5511999990000
# AUTHORIZED_WHATSAPP_NUMBERS=5511999990000,5511888880000
# EVOLUTION_URL=http://evolution_go:4000
# EVOLUTION_TOKEN=

# Webhook do GitHub (desligado enquanto o segredo estiver vazio).
# Use o mesmo valor no campo "Secret" do webhook no GitHub.
# GITHUB_WEBHOOK_SECRET=

# Terminal "nuvem" a partir do console local
# NEXUS_AWS_HOST=
# NEXUS_AWS_USER=ubuntu
# NEXUS_AWS_KEY=~/.ssh/sua-chave.pem

# Checagem de latência do painel (alvo vazio = não checa)
# TRAEFIK_TCP_TARGET=host:80
# REDIS_TCP_TARGET=host:6379
# POSTGRES_TCP_TARGET=host:5432

# Login por Traefik ForwardAuth. Só ligue se o Traefik realmente aplicar o
# middleware de ForwardAuth na rota /auth/google e sobrescrever X-Forwarded-User.
# CONSOLE_FORWARD_AUTH=true
# CONSOLE_COOKIE_DOMAIN=seudominio.com

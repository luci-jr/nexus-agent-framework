# ==============================================================================
# ⚛️ Nexus Ecosystem (Open Source Edition) — Variáveis de Deploy na Nuvem (VPS)
# ==============================================================================

# Domínio público apontado para o IP da sua VPS / Cloud (DNS direto ou via Cloudflare)
NEXUS_DOMAIN=nexus.seudominio.com

# E-mail válido para emissão de certificados SSL automáticos via Let's Encrypt
ACME_EMAIL=seu-email@exemplo.com

# Credenciais de acesso seguro ao Nexus Web Console
CONSOLE_USER=admin
CONSOLE_PASSWORD=altere_sua_senha_segura_aqui

# Porta interna do console
PORT=8090
NEXUS_ENV=production

